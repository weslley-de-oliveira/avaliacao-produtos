# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (sessão assinada em cookie)
AUTH_SESSION_SECRET=

# Mastra (agentes de IA)
# Resumo das avaliações: Gemini por padrão (plano gratuito), chave em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional: outro modelo do resumo (provedor/modelo), ex.: groq/llama-3.3-70b-versatile com GROQ_API_KEY
AI_SUMMARY_MODEL=
# Agente de suporte (scaffold) e, se escolhido, modelo openai/... do resumo
OPENAI_API_KEY=

# n8n (automação - docker compose)
N8N_ENCRYPTION_KEY=
